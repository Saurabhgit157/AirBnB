<% layout("/layouts/boilerplate") -%>

<div class="row justify-content-center mt-5">
    <div class="col-md-5 col-sm-10">

        <div class="card shadow-lg border-0" style="border-radius: 16px; overflow: hidden;">

            <!-- Card Header -->
            <div class="card-header text-white text-center py-4"
                style="background: linear-gradient(135deg, #fe424d, #ff6b6b);">
                <i class="fa-solid fa-compass fa-2x mb-2"></i>
                <h3 class="mb-0 fw-bold">Welcome Back!</h3>
                <p class="mb-0 opacity-75 small">Log in to your WanderLust account</p>
            </div>

            <!-- Card Body -->
            <div class="card-body p-4">
                <form method="POST" action="/login" novalidate class="needs-validation">

                    <!-- Username -->
                    <div class="mb-3">
                        <label for="username" class="form-label fw-semibold">
                            <i class="fa-solid fa-user me-1 text-danger"></i> Username
                        </label>
                        <input
                            type="text"
                            id="username"
                            name="username"
                            class="form-control"
                            placeholder="Your username"
                            required
                            autofocus
                        >
                        <div class="invalid-feedback">Please enter your username.</div>
                    </div>

                    <!-- Password -->
                    <div class="mb-4">
                        <label for="password" class="form-label fw-semibold">
                            <i class="fa-solid fa-lock me-1 text-danger"></i> Password
                        </label>
                        <input
                            type="password"
                            id="password"
                            name="password"
                            class="form-control"
                            placeholder="Your password"
                            required
                        >
                        <div class="invalid-feedback">Please enter your password.</div>
                    </div>

                    <!-- Submit -->
                    <div class="d-grid">
                        <button type="submit" class="btn btn-danger btn-lg fw-semibold"
                            style="background: linear-gradient(135deg, #fe424d, #ff6b6b); border: none; border-radius: 10px;">
                            <i class="fa-solid fa-right-to-bracket me-2"></i>Log In
                        </button>
                    </div>

                </form>

                <hr class="my-4">

                <p class="text-center text-muted mb-0">
                    New to WanderLust?
                    <a href="/signup" class="text-danger fw-semibold text-decoration-none">Sign up for free</a>
                </p>
            </div>

        </div>
    </div>
</div>

<script src="/js/script.js"></script>
